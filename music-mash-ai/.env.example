# Application Settings
APP_NAME=Music Mash AI Service
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./music_mash_ai.db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# File Storage
# Must be the SAME folder as Spring's file.upload-dir: Spring sends only the file name
# and the AI service reads <UPLOAD_DIR>/<file name> (see app/core/uploads.py).
UPLOAD_DIR=../music-mash-backend/uploads
MAX_FILE_SIZE=104857600

# AI Processing
SAMPLE_RATE=22050
HOP_LENGTH=512
N_FFT=2048
N_MELS=128

# Model Paths
MODEL_DIR=./models

# Spring Boot Integration
SPRING_BOOT_URL=http://localhost:8081

# Logging
LOG_LEVEL=INFO
