# Copy these into your shell / IDE run configuration before starting the backend.
# Spring Boot reads them via ${...} placeholders in application.properties.

# MySQL credentials for jdbc:mysql://localhost:3306/music_mash
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing key. MUST be Base64-encoded and decode to at least 32 bytes (HS256).
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or in Git Bash:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-base64-encoded-secret
